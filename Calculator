#include <stdio.h>
int main(){
    int a,b;
    char op;
    printf("Enter a number");
    scanf("%d",&a);
    printf("Enter b number");
    scanf("%d",&b);
    printf ("Enter the operator (+,-,/,%,*) :");
        scanf(" %c",&op);
    switch(op)
        {
            case'+':
            printf ("%d",a+b);
            break;
            case'-':
            printf("%d",a-b);
            break;
            case'/':
            printf ("%d",a/b);
            break;
            case'%':
            printf("%d",a%b);
            break;
            case'*':
            printf("%d",a*b);
            break;
            default:
                printf("invalid ");
        }
    return 0;
}
